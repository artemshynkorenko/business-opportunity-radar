# Business Opportunity Radar — environment variables
# Copy this file to .env and fill in the values for local development
# Never commit .env with real secrets

# Future: LLM provider (not required for MVP Core v0.1)
# OPENAI_API_KEY=

# Future: Reddit OAuth (not required for MVP Core v0.1)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=

# Threads API — required by the Threads source adapter (src/sources/threads).
# Not required to run the source-independent core or the test suite (tests mock HTTP).
# THREADS_ACCESS_TOKEN=

# Threads OAuth — required only by the Meta Review Demo web app (npm run demo).
# Read-only scopes are requested: threads_basic, threads_keyword_search.
# The access token is held server-side and never sent to the browser.
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
# THREADS_REDIRECT_URI=https://your-host/auth/threads/callback
# PORT=3000

# Future: PostgreSQL (not required for MVP Core v0.1)
# DATABASE_URL=postgresql://user:password@localhost:5432/business_radar
