{
  "name": "business-opportunity-radar",
  "version": "0.1.0",
  "description": "Private AI-powered business opportunity discovery system",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "smoke:threads": "npm run build && node --env-file-if-exists=.env dist/scripts/smoke-threads.js",
    "smoke:threads:pipeline": "npm run build && node --env-file-if-exists=.env dist/scripts/smoke-threads-pipeline.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
